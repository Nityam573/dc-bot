# ── Google Gemini ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ── Pinecone ───────────────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=support-docs
PINECONE_NAMESPACE=v1

# ── Discord ────────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_SUPPORT_CHANNEL_IDS=

# ── RAG Tuning ────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RESULTS=5
MIN_CONFIDENCE_SCORE=0.5

# ── Redis (worker queue) ───────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ── Upload API ────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
ADMIN_TOKEN=
